# Server
PORT=3000
NODE_ENV=development
# Used to build the Paystack callback_url (where the browser is redirected
# after payment) and, if you deploy, should be your real public URL —
# Paystack must be able to redirect the customer's browser here.
APP_BASE_URL=http://localhost:3000

# Database (MySQL)
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=gsu_food_system

# Auth
JWT_SECRET=replace_this_with_a_long_random_string
JWT_EXPIRES_IN=1d

# Payment Gateway (Paystack)
PAYSTACK_SECRET_KEY=sk_test_xxxxxxxxxxxxxxxxxxxxxxxx
PAYSTACK_PUBLIC_KEY=pk_test_xxxxxxxxxxxxxxxxxxxxxxxx

# Payment Gateway (Flutterwave) - optional, if supporting both
FLW_SECRET_KEY=FLWSECK_TEST-xxxxxxxxxxxxxxxxxxxxxxxx
FLW_PUBLIC_KEY=FLWPUBK_TEST-xxxxxxxxxxxxxxxxxxxxxxxx

# Rate limiting
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100

# First admin account bootstrap (npm run seed:admin) — only used if no
# admin exists yet. Change this password immediately after first login
# if you leave the default.
ADMIN_FULL_NAME=System Administrator
ADMIN_EMAIL=admin@gsu-food.local
ADMIN_PHONE=0000000000
ADMIN_PASSWORD=ChangeMe123!
